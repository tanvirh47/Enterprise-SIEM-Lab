<group name="local,sysmon,windows,">

  <rule id="100001" level="12">
    <if_group>sysmon_event1</if_group>

    <field name="win.eventdata.commandLine" type="pcre2">(?i)-enc</field>

    <description>
      Suspicious PowerShell encoded command detected
    </description>

    <mitre>
      <id>T1059.001</id>
    </mitre>

  </rule>

</group>